<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Conversation Coach</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>conversation_coach</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Capture & recording (F-CAP-01/02). The USB-C route (e.g. DJI Mic) is
	     selected through AVAudioSession's USB audio input. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Conversation Coach records your conversations — with consent — so it can transcribe and coach you on them. Audio stays on your device unless you opt in to cloud transcription.</string>

	<!-- Background audio so recording continues with the screen locked
	     (F-CAP-07). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- The app only uses standard HTTPS (TLS) — for the one-time on-device
	     model download — which is exempt encryption. Declaring this lets
	     TestFlight/App Store uploads skip the export-compliance questionnaire. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- v2 on-device inference (flutter_gemma / LiteRT-LM): expose the model
	     files for management, and declare local-network use for the runtime. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used only by the on-device AI model runtime. No data leaves your device.</string>
</dict>
</plist>
